@using Microsoft.AspNetCore.Identity
@using GestionCentreDeFormation.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GCF</title>
    
    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Custom Neo-Brutalism CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Public Layout -->
    <header class="p-3 border-bottom border-3 border-dark bg-black sticky-top" style="border-bottom: 3px solid #000;">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none me-5">
                    <span class="fs-3 fw-black text-uppercase" style="font-weight: 900; letter-spacing: -1px;">GCF<span style="color: var(--brand-blue);">.</span></span>
                </a>

                <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                    <li><a asp-page="/Index" class="nav-link px-3 link-light fw-bold text-uppercase" style="letter-spacing: 1px;">Home</a></li>
                    <li><a asp-page="/Courses/Index" class="nav-link px-3 link-light fw-bold text-uppercase" style="letter-spacing: 1px;">Courses</a></li>
                    @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                    {
                        <li><a asp-page="/Planning/Index" class="nav-link px-3 link-light fw-bold text-uppercase" style="letter-spacing: 1px; color: #FFD700 !important;">Planning</a></li>
                        @if (User.IsInRole("Student"))
                        {
                            <li><a asp-page="/Students/MyCourses" class="nav-link px-3 link-light fw-bold text-uppercase" style="letter-spacing: 1px;">My Courses</a></li>
                            
                            @if (User.Identity.IsAuthenticated)
                            {
                                var user = await UserManager.GetUserAsync(User);
                                if (user != null)
                                {
                                    <li class="d-flex align-items-center ms-3">
                                        <span class="badge bg-white text-black rounded-0 fw-bold border border-white" style="cursor: pointer;" onclick="openTopUpModal()">
                                            <i class="bi bi-wallet2 me-2"></i> @user.Balance.ToString("N0") MAD
                                        </span>
                                    </li>
                                }
                            }
                        }
                    }
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <li><a href="#features" class="nav-link px-3 link-light fw-bold text-uppercase" style="letter-spacing: 1px;">Why Us</a></li>
                    }
                </ul>

                <div class="text-end">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="py-5 border-top border-3 border-dark bg-white" style="border-top: 3px solid #000;">
        <div class="container">
            <div class="row">
                <div class="col-2">
                    <h5 class="fw-black text-uppercase mb-3">GCF.</h5>
                    <p class="text-muted small fw-bold">Excellence in education management.</p>
                </div>
                <div class="col-2">
                    <h5 class="fw-bold text-uppercase mb-3">Section</h5>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-dark fw-bold">Home</a></li>
                        <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-dark fw-bold">Features</a></li>
                        <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-dark fw-bold">Pricing</a></li>
                    </ul>
                </div>
                <div class="col-2">
                    <h5 class="fw-bold text-uppercase mb-3">Section</h5>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-dark fw-bold">FAQs</a></li>
                        <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-dark fw-bold">About</a></li>
                    </ul>
                </div>
                <div class="col-4 offset-1">
                    <form>
                        <h5 class="fw-bold text-uppercase mb-3">Subscribe</h5>
                        <p class="text-muted small fw-bold">Monthly digest of what's new and exciting.</p>
                        <div class="d-flex w-100 gap-2">
                            <label for="newsletter1" class="visually-hidden">Email address</label>
                            <input id="newsletter1" type="text" class="form-control" placeholder="EMAIL ADDRESS" style="border: 2px solid #000; border-radius: 0;">
                            <button class="btn btn-primary" type="button" style="border-radius: 0; border: 2px solid #000; font-weight: 900;">SUBSCRIBE</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="d-flex justify-content-between py-4 my-4 border-top border-dark">
                <p class="fw-bold">&copy; 2025 Gestion Centre de Formation. All rights reserved.</p>
                <ul class="list-unstyled d-flex">
                    <li class="ms-3"><a class="link-dark" href="#"><i class="bi bi-twitter"></i></a></li>
                    <li class="ms-3"><a class="link-dark" href="#"><i class="bi bi-instagram"></i></a></li>
                    <li class="ms-3"><a class="link-dark" href="#"><i class="bi bi-facebook"></i></a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Fake Stripe Modal -->
    <div class="modal fade" id="topUpModal" tabindex="-1" aria-labelledby="topUpModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow-lg border-0">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="topUpModalLabel">Top Up Balance</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0">
                    <div class="text-center mb-4">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/ba/Stripe_Logo%2C_revised_2016.svg" alt="Stripe" height="40" class="mb-3">
                        <p class="text-muted">Secure payment processing</p>
                    </div>
                    <form id="fakePaymentForm">
                        <div class="mb-3">
                            <label for="amount" class="form-label fw-bold">Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">MAD</span>
                                <input type="number" class="form-control" id="amount" placeholder="0.00" value="100">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="cardNumber" class="form-label fw-bold">Card Information</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                <input type="text" class="form-control" id="cardNumber" placeholder="0000 0000 0000 0000">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label for="expiry" class="form-label fw-bold">Expiry</label>
                                <input type="text" class="form-control" id="expiry" placeholder="MM/YY">
                            </div>
                            <div class="col-6 mb-3">
                                <label for="cvc" class="form-label fw-bold">CVC</label>
                                <input type="text" class="form-control" id="cvc" placeholder="123">
                            </div>
                        </div>
                        <div class="d-grid mt-3">
                            <button type="button" class="btn btn-primary btn-lg fw-bold" onclick="processFakePayment()">Pay Now</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openTopUpModal() {
            var myModal = new bootstrap.Modal(document.getElementById('topUpModal'));
            myModal.show();
        }

        function processFakePayment() {
            var btn = document.querySelector('#fakePaymentForm button');
            var amountInput = document.getElementById('amount');
            var amount = amountInput.value;
            var originalText = btn.innerHTML;
            
            if (!amount || amount <= 0) {
                alert("Please enter a valid amount.");
                return;
            }

            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing...';
            btn.disabled = true;

            // Create FormData to send data
            var formData = new FormData();
            formData.append('amount', amount);

            fetch('/TopUp', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    btn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Success!';
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-success');
                    
                    setTimeout(function() {
                        var modalEl = document.getElementById('topUpModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();
                        
                        // Update balance in the UI
                        var balanceBadge = document.querySelector('.badge.bg-white');
                        if (balanceBadge) {
                            balanceBadge.innerHTML = '<i class="bi bi-wallet2 me-2"></i> ' + data.newBalance + ' MAD';
                        }
                        
                        // Reset button
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-primary');
                        
                        alert("Payment Successful! Your balance has been updated.");
                    }, 1500);
                } else {
                    alert("Payment failed: " + (data.message || "Unknown error"));
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("An error occurred while processing the payment.");
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
